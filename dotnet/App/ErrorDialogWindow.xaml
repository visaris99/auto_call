<Window x:Class="MilestoneDialer.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오류" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="{StaticResource B.Background}"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="CodeBadge" Background="{StaticResource B.DangerSoft}"
                    CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <TextBlock x:Name="CodeText" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource B.Danger}"/>
            </Border>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource B.Ink}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                   Foreground="{StaticResource B.Foreground}" Margin="0,12,0,0"/>

        <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line}"
                BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="다음 행동" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource B.MutedText}"/>
                <TextBlock x:Name="NextActionText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource B.Ink}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyReportBtn" Content="관리자 보고 복사" Style="{StaticResource GhostBtn}"
                    MinHeight="34" MinWidth="128" FontSize="12" Click="CopyReport_Click"/>
            <Button Content="확인" Style="{StaticResource PrimaryBtn}"
                    MinHeight="34" MinWidth="88" FontSize="12" Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
