<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>  <!-- NotifyIcon(트레이 알림) 용 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>milestone_dialer</AssemblyName>
    <RootNamespace>MilestoneDialer</RootNamespace>
    <Product>Milestone Dialer</Product>
    <Company>Milestone Invest</Company>
    <Description>Milestone CRM Dialer</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- WinForms 암시적 using이 WPF 타입(Brush/Application)과 충돌하므로 제거 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\milestone_logo.png" Link="assets\milestone_logo.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.ico" Link="assets\icon.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 나눔고딕 번들 — PC별 설치 여부에 따른 렌더링 편차 제거.
       SIL OFL 1.1 라이선스: 폰트를 배포물에 포함하려면 OFL.txt를 함께 배포해야 한다. -->
  <ItemGroup>
    <Resource Include="Fonts\NanumGothic-Regular.ttf" />
    <Resource Include="Fonts\NanumGothic-Bold.ttf" />
    <Resource Include="Fonts\NanumGothic-ExtraBold.ttf" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
