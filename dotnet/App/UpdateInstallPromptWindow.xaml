<Window x:Class="MilestoneDialer.UpdateInstallPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업데이트 설치" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource B.Background}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="통화가 진행 중입니다" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource B.Ink}"/>
            <TextBlock Text="업데이트 파일 준비가 끝났습니다. 지금 설치하면 앱이 종료됩니다."
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource B.Foreground}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="통화 끝나고 설치" Style="{StaticResource GhostBtn}"
                    Width="150" Height="36" Click="InstallLater_Click"/>
            <Button Content="지금 설치" Style="{StaticResource PrimaryBtn}"
                    Width="110" Height="36" Margin="8,0,0,0" Click="InstallNow_Click"/>
        </StackPanel>
    </Grid>
</Window>
